# Copie para .env.local. Só devnet. Nunca coloque chave privada aqui.

# RPC de devnet. Sem valor, cai no público https://api.devnet.solana.com.
# Helius devnet: https://devnet.helius-rpc.com/?api-key=SUA_CHAVE
NEXT_PUBLIC_RPC_URL=

# true = telas usam dados fictícios (plano B para gravação). false = on-chain.
NEXT_PUBLIC_DEMO_MODE=true

# Multisig compartilhado (opcional). Sem ele, o endereço vem do localStorage após /setup.
NEXT_PUBLIC_MULTISIG_ADDRESS=

# Cotação fixa só para mostrar "≈ R$" ao lado de SOL. Não é oráculo.
NEXT_PUBLIC_BRL_POR_SOL=900

# Helius (Fase 5, extrato parseado). Preferir a versão sem NEXT_PUBLIC_ (fica no servidor).
HELIUS_API_KEY=
NEXT_PUBLIC_HELIUS_API_KEY=
